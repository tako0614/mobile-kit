{
  "name": "@takosjp/mobile-kit",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./solid": "./src/solid.ts",
    "./vite": "./src/vite.ts",
    "./mobile-shell.css": "./src/mobile-shell.css"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "scripts": {
    "build": "bun build src/index.ts src/solid.ts --target=browser --outdir=dist && bun build src/vite.ts --target=bun --outdir=dist",
    "check": "bun run fmt:check && bun run lint && bun run test && bun run build",
    "fmt:check": "bun scripts/check-source-format.mjs",
    "lint": "bun run typecheck",
    "test": "bun test tests/src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "solid-js": "^1.9.13",
    "typescript": "^5.7.0"
  }
}
